{
  "$schema": "https://json.schemastore.org/bicep.json",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "sqlLocation": {
      "value": "${AZURE_SQL_LOCATION=centralus}"
    },
    "appBaseUrl": {
      "value": "${APP_BASE_URL=}"
    },
    "sqlAdminPassword": {
      "value": "${AZURE_SQL_ADMIN_PASSWORD}"
    },
    "sessionSecret": {
      "value": "${SESSION_SECRET}"
    },
    "inviteCode": {
      "value": "${INVITE_CODE}"
    },
    "adminEmails": {
      "value": "${ADMIN_EMAILS=travel@kingdavidconsulting.com}"
    }
  }
}
