{
  "$schema": "https://aka.ms/azure/static-web-apps-cli/schema",
  "configurations": {
    "trip-planner": {
      "env": "production",
      "appLocation": ".",
      "outputLocation": "dist",
      "apiLocation": "api/scripts",
      "apiLanguage": "node",
      "apiVersion": "22",
      "appBuildCommand": "npm run build",
      "apiBuildCommand": "node build-deploy.mjs",
      "run": "npm run dev",
      "appDevserverUrl": "http://localhost:5173"
    }
  }
}
