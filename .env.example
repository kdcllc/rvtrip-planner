# Trip Planner Environment Variables
# The app works with no configuration - these are optional enhancements

# OpenRouteService (optional - adds third routing fallback)
# Free tier available at https://openrouteservice.org/dev/#/signup
# Provides 2,000 requests/day
VITE_OPENROUTE_API_KEY=

# ---------------------------------------------------------------------------
# Server-side settings (Azure Functions API). Names and placeholders ONLY.
# In production these are configured as Static Web App application settings
# (applied by Bicep); never commit real values. For local dev, put them in
# api/local.settings.json (git-ignored) or export them in your shell.
# ---------------------------------------------------------------------------
SQL_CONNECTION_STRING=Server=localhost,1433;Database=tripplanner;User Id=sa;Password=<local-dev-password>;TrustServerCertificate=True
SESSION_SECRET=<long-random-string>
ACS_CONNECTION_STRING=<azure-communication-services-connection-string>
ACS_SENDER_ADDRESS=<sender@your-verified-domain>
APP_BASE_URL=http://localhost:4280
INVITE_CODE=<invite-code>
