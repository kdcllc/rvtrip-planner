# Trip Planner environment variables: names and placeholder values only.
# Never put a real value in this file. Copy the lines you need into the place
# named in each section. See QUICKSTART.md for local setup.

# ---------------------------------------------------------------------------
# Browser build (Vite). Optional. Put it in a git-ignored `.env` file in the
# repo root. The map, routing, geocoding and weather work without it.
# ---------------------------------------------------------------------------

# OpenRouteService API key (optional): third routing fallback, used when both
# OSRM servers are unreachable. Free tier: https://openrouteservice.org/dev/#/signup
VITE_OPENROUTE_API_KEY=your-api-key

# ---------------------------------------------------------------------------
# Server-side settings (Azure Functions API in api/), read from process.env by
# api/src/shared/config.ts. Vite does not read these. For local runs put them
# under "Values" in api/local.settings.json (git-ignored) or export them in
# your shell. In Azure they are Static Web App application settings applied by
# Bicep (infra/main.bicep).
# ---------------------------------------------------------------------------

# SQL Server / Azure SQL connection string. The local value matches the Docker
# database from `npm run db:up` (see db/README.md for the local password).
SQL_CONNECTION_STRING=Server=localhost,1433;Database=tripplanner;User Id=sa;Password=your-local-db-password;TrustServerCertificate=True

# Secret used to hash values such as the requester IP on access requests.
# Use a long random string.
SESSION_SECRET=your-long-random-string

# Azure Communication Services connection string, used to send email (password
# reset, invites, access-request notifications). Only needed to send email.
ACS_CONNECTION_STRING=your-acs-connection-string

# Sender address for that email; must belong to a domain linked to the ACS resource.
ACS_SENDER_ADDRESS=sender@your-verified-domain.example

# Public origin of the app. The API accepts sign-in and other changes only from
# this origin and uses it in emailed links. 4280 is the SWA CLI port used by
# `npm run dev:swa`.
APP_BASE_URL=http://localhost:4280

# Shared invite code that registration accepts (single-use invite codes also work).
INVITE_CODE=your-invite-code

# Optional. Comma-separated admin emails: these accounts see "Access requests"
# and receive access-request notifications. Empty means no admins.
ADMIN_EMAILS=admin@example.com
