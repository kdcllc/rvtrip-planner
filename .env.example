# Trip Planner Environment Variables
# The app works with no configuration - these are optional enhancements

# OpenRouteService (optional - adds third routing fallback)
# Free tier available at https://openrouteservice.org/dev/#/signup
# Provides 2,000 requests/day
VITE_OPENROUTE_API_KEY=

# Google Drive (optional - enables cloud sync/backup of trips)  
# Create OAuth 2.0 credentials at https://console.cloud.google.com/
VITE_GOOGLE_DRIVE_CLIENT_ID=
